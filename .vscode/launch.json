{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python: Run Tests",
            "type": "debugpy",
            "request": "launch",
            "module": "coverage",
            "args": [
                "run",
                "--source=django",
                "-m",
                "pytest",
                "django/tests",
            ],
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            },
            "postDebugTask": "coverage:report",
        },
        {
            "name": "Python: Run Chat Tests",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": [
                "django/tests/chat"
            ],
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            }
        },
        {
            "name": "Python: Run Librarian Tests",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": [
                "django/tests/librarian"
            ],
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            }
        },
        {
            "name": "Django: Text Extractor Views Text",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": [
                "django/tests/text_extractor"
            ],
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            }
        },
        {
            "name": "Django: Run Legislation Search Tests",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": [
                "django/tests/laws"
            ],
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            }
        },
        {
            "name": "Django: Eval Library QA",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/django/manage.py",
            "args": [
                "eval_responses",
                "mini_library_qa.yaml"
            ],
            "django": true
        },
        {
            "name": "Django: Reset App Data",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/django/manage.py",
            "args": [
                "reset_app_data",
                "apps"
            ],
            "django": true
        },
        {
            "name": "Django: Migrate",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/django/manage.py",
            "args": [
                "migrate"
            ],
            "django": true
        },
        {
            "name": "Django: Sync Users",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/django/manage.py",
            "args": [
                "sync_users",
            ],
            "django": true
        },
        {
            "name": "Django: Run Server",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/django/manage.py",
            "args": [
                "runserver",
            ],
            "django": true,
            "justMyCode": false
        },
        {
            "name": "Django: Load Laws",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/django/manage.py",
            "args": [
                "load_laws_xml",
                "--small",
            ],
            "django": true,
            "justMyCode": false
        },
        {
            "name": "Python: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}"
        },
        {
            "name": "Django: Celery Worker (All Queues)",
            "type": "debugpy",
            "request": "launch",
            "module": "celery",
            "cwd": "${workspaceFolder}/django",
            "args": [
                "-A",
                "otto",
                "worker",
                "-l",
                "INFO",
                "-Q",
                "light,embed,heavy",
                "--pool=gevent",
                "--concurrency=16",
                "--hostname=light@%h",
                "--prefetch-multiplier=1"
            ],
            "env": {
                "GEVENT_SUPPORT": "True"
            }
        },
        {
            "name": "Django: Celery Worker (Light & Embed Queues)",
            "type": "debugpy",
            "request": "launch",
            "module": "celery",
            "cwd": "${workspaceFolder}/django",
            "args": [
                "-A",
                "otto",
                "worker",
                "-l",
                "INFO",
                "-Q",
                "light,embed",
                "--pool=gevent",
                "--concurrency=16",
                "--hostname=light@%h",
                "--prefetch-multiplier=1"
            ],
            "env": {
                "GEVENT_SUPPORT": "True"
            }
        },
        {
            "name": "Django: Celery Worker (Heavy Queue)",
            "type": "debugpy",
            "request": "launch",
            "module": "celery",
            "cwd": "${workspaceFolder}/django",
            "args": [
                "-A",
                "otto",
                "worker",
                "-l",
                "INFO",
                "-Q",
                "heavy",
                "-n",
                "--pool=prefork",
                "--concurrency=1",
                "--hostname=heavy@%h",
                "--prefetch-multiplier=1"
            ]
        },
        {
            "name": "Django: Celery Beat",
            "type": "debugpy",
            "request": "launch",
            "module": "celery",
            "cwd": "${workspaceFolder}/django",
            "args": [
                "-A",
                "otto",
                "beat",
                "-l",
                "INFO",
                "--scheduler",
                "django_celery_beat.schedulers:DatabaseScheduler"
            ]
        }
    ],
    "compounds": [
        {
            "name": "Django: Server + Celery",
            "configurations": [
                "Django: Run Server",
                "Django: Celery Worker (All Queues)",
            ]
        }
    ]
}
