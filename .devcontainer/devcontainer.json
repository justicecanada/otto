{
    "name": "Otto",
    "dockerComposeFile": "docker-compose.yml",
    "service": "app",
    "workspaceFolder": "/workspace",
    "mounts": [],
    "forwardPorts": [
        8000,
        5432,
        6379
    ],
    "customizations": {
        "vscode": {
            "extensions": [
                "charliermarsh.ruff",
                "ms-python.python",
                "streetsidesoftware.code-spell-checker",
                "monosans.djlint",
                "hongquan.dragon-jinja",
                "mkhl.shfmt",
                "timonwong.shellcheck"
            ]
        }
    }
}
