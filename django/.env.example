# ----------------------------------------
# PROBABLY DON'T NEED TO MODIFY THESE
# ----------------------------------------

# Variable describing in which environment the Django app is to be executed
ENV=LOCAL
# Choose between:
# LOCAL: for local development
# DEV: for deployment on dev server
# UAT: for deployment on uat server
# PROD: for deployment on prod server
# TEST: for running tests on ci/cd server

SITE_URL=http://localhost:8000
CREDENTIAL_TYPE=default
DEBUG=True
# Optional local-only fallback for VS Code integrated browser testing when Entra blocks embedded browsers.
# Opt in manually for this workspace when needed. Never enable this outside local development.
ENABLE_BROWSER_TEST_AUTH=False
LOG_LEVEL=INFO
CELERY_LOG_LEVEL=INFO
DEBUG_TOOLBAR=False
MEDIA_ROOT=media

DJANGODB_ENGINE=django.db.backends.postgresql_psycopg2
DJANGODB_NAME=otto
DJANGODB_USER=postgres
DJANGODB_PASSWORD=password
# These need to be overriden in .env for using pgbouncer locally - see comments below
# localhost for pgbouncer; postgres-service for direct connection
DJANGODB_HOST=postgres-service
# 6432 for pgbouncer; 5432 for direct connection
DJANGODB_PORT=5432
DJANGODB_PGBOUNCER=False

VECTORDB_ENGINE=django.db.backends.postgresql_psycopg2
VECTORDB_NAME=llama_index
VECTORDB_USER=postgres
VECTORDB_PASSWORD=password
# These need to be overriden in .env for using pgbouncer locally - see comments below
# localhost for pgbouncer; postgres-service for direct connection
VECTORDB_HOST=postgres-service
# 6432 for pgbouncer; 5432 for direct connection
VECTORDB_PORT=5432
VECTORDB_PGBOUNCER=False

AZURE_STORAGE_ACCOUNT_NAME=stottodevshared57e5c9
AZURE_STORAGE_CONTAINER=otto
AZURE_KEYVAULT_URL=https://kv-otto-devshared.vault.azure.net/
AI_SERVICES_NAME=ai-otto-devshared
AZURE_AI_SERVICES_ENDPOINT="https://ai-otto-devshared.cognitiveservices.azure.com/"
AZURE_AI_SERVICES_VERSION=v1
AZURE_AI_SERVICES_REGION="canadacentral"
# Optional: run Azure Language PII screening on outbound external-tool queries
# before showing approval UI. Defaults to local heuristics only.
EXTERNAL_TOOL_AZURE_LANGUAGE_REVIEW_ENABLED=True
# Optional override; defaults to AZURE_AI_SERVICES_ENDPOINT when blank.
EXTERNAL_TOOL_AZURE_LANGUAGE_REVIEW_ENDPOINT=""
EXTERNAL_TOOL_AZURE_LANGUAGE_REVIEW_API_VERSION=2022-05-01
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT="https://di-otto-devshared.cognitiveservices.azure.com/"
AZURE_SPEECH_TO_TEXT_ENDPOINT="https://canadaeast.stt.speech.microsoft.com"

DJANGO_SECRET_KEY="django-secret-key"
ENTRA_REDIRECT_URI="/accounts/login/callback"


CHUNK_EMBEDDING_PARALLEL_REQUESTS="1"

# Demo keys - override these in `.env` with your own keys to avoid rate limits
